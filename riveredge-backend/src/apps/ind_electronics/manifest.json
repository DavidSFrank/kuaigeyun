        "permission": "ind-electronics:esd:read",
        "sort_order": 70
      },
      {
        "title": "app.ind-electronics.menu.esdInspection",
        "path": "/apps/ind-electronics/esd/inspection",
        "permission": "ind-electronics:esd:read",
        "sort_order": 80
      },
      {
        "title": "app.ind-electronics.menu.esd",
        "path": "/apps/ind-electronics/esd",
        "permission": "ind-electronics:esd:read",
        "sort_order": 90
      }
    ]
  },
  "industry_extensions": [
    {
      "id": "electronics.sample_process",
      "kind": "replace",
      "strategy": "profile",
      "host_app": "kuaiplm",
