# KU-Bridge WorkBuddy MCP Sidecar 环境变量（复制为 workbuddy-mcp.env，勿提交 Git）
# 路径：fast-deploy/config/workbuddy-mcp.env
#
# 与 WorkBuddy 的 mcp.json 无关：秘钥只放本文件，由 Sidecar 换开放 API Token。

RIVEREDGE_BASE_URL=https://kuaigeyun.com
OPEN_API_ACCT_ID=
OPEN_API_APP_ID=
OPEN_API_APP_SECRET=
OPEN_API_TENANT_ID=

# 可选：Sidecar 进程参数（systemd 也会注入 MCP_HOST/MCP_PORT/MCP_TRANSPORT）
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MCP_TRANSPORT=streamable-http
